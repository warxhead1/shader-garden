# Copy to deploy/host.env and replace every placeholder. The real file is
# gitignored because SG_TURN_SHARED_SECRET must remain server-side.
SG_PUBLIC_HOST=replace-me.example.com
SG_PUBLIC_IP=203.0.113.10
SG_ALLOWED_ORIGINS=https://owner.github.io
SG_TURN_SHARED_SECRET=replace-with-openssl-rand-hex-32
SG_TURN_URLS=turn:replace-me.example.com:3478?transport=udp,turn:replace-me.example.com:3478?transport=tcp
SG_TURN_TTL_SECONDS=600
SG_TURN_CREDENTIALS_PER_MINUTE=30
