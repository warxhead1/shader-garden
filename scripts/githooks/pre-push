#!/usr/bin/env bash
# Blocking real-GPU gate on push. Enable with:
#     git config core.hooksPath scripts/githooks
#
# CI cannot prove anything this gate proves — GitHub's runners have no GPU, so
# every real-GPU suite runs there with SG_ALLOW_SOFTWARE=1, which switches off
# the exact assertion that matters. This is the only enforcement point for
# "the pixels really came off the GPU". See scripts/gpu-gate.sh.
#
# Escape hatch, for a docs-only or clearly non-rendering push:
#     SG_SKIP_GPU_GATE=1 git push ...
# Use it deliberately. It is not a way to push a red bar.
set -u

if [ -n "${SG_SKIP_GPU_GATE:-}" ]; then
  echo "pre-push: GPU gate SKIPPED by SG_SKIP_GPU_GATE." >&2
  exit 0
fi

# Nothing to prove when the push deletes a ref or has no new commits.
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  case "$local_sha" in *[!0]*) only_deletes=0 ;; esac
done
[ "$only_deletes" -eq 1 ] && exit 0

root="$(git rev-parse --show-toplevel)"

echo "pre-push: budgets..."
if ! python3 "$root/tools/check_budgets.py" >/dev/null 2>&1; then
  python3 "$root/tools/check_budgets.py" 2>&1 | grep -E '^FAIL' >&2
  echo "pre-push: BLOCKED — budgets are red." >&2
  exit 1
fi

echo "pre-push: real-GPU gate (sequential, several minutes)..."
if ! SG_ALLOW_SOFTWARE= "$root/scripts/gpu-gate.sh"; then
  echo "pre-push: BLOCKED — the real-GPU gate failed." >&2
  exit 1
fi
